# Copy to .env and replace the placeholders. Never commit .env.

POSTGRES_ADMIN_PASSWORD=change_me
GROSHIK_APP_PASSWORD=change_me

# Migration connection: the owner role may run DDL.
DATABASE_URL=postgres://groshik_admin:change_me@localhost:5432/groshik

# Runtime connection: the restricted application role cannot run DDL.
# Local Docker PostgreSQL is loopback-only and has TLS disabled, so the local
# URL must state sslmode=disable explicitly. Staging and production must use
# sslmode=verify-full and the CA certificate supplied by the DB provider.
APP_DATABASE_URL=postgres://groshik_app:change_me@localhost:5432/groshik?sslmode=disable
