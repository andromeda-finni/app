# Copy to .env and fill in real values. .env is gitignored — never commit real secrets.

POSTGRES_ADMIN_PASSWORD=change_me
GROSHIK_APP_PASSWORD=change_me

# Used by db/scripts/migrate.sh (admin/owner role — can run DDL).
DATABASE_URL=postgres://groshik_admin:change_me@localhost:5432/groshik

# Used by the backend at runtime (least-privilege role — no DDL rights).
# sslmode=prefer here because the local docker-compose Postgres has TLS off
# and traffic stays on loopback. In staging/production (managed Postgres,
# traffic over a real network) this MUST be sslmode=verify-full with a CA
# certificate to actually prevent MITM — see README "Security" section.
APP_DATABASE_URL=postgres://groshik_app:change_me@localhost:5432/groshik?sslmode=prefer
