# Server-side secrets for deploy/docker-compose.yml. bootstrap.sh creates
# /opt/groshik/.env with random passwords; this file is only a reference.
# Never commit the real .env.
API_DOMAIN=groshiktheapp.ru
POSTGRES_ADMIN_PASSWORD=change-me
GROSHIK_APP_PASSWORD=change-me
# Only needed for a deployed Flutter web build, comma-separated.
CORS_ORIGINS=
